          "request": {
            "agent": "{{AGENT_A}}",
            "direct_call": {
              "tool": "read_file",
              "args": {
                "path": "{{OK_FILE}}"
              }
            },
            "definition_change": {
              "tool": "read_file",
              "op": "widen_scope"
            }
          },
          "expect": {
            "outcome": [
              "blocked"
            ]
          }
        }
      ]
    },
    {
      "id": "unchanged",
      "kind": "benign",
      "technique": "definition unchanged since approval",
      "steps": [
        {
          "request": {
            "agent": "{{AGENT_A}}",
            "direct_call": {
              "tool": "read_file",
              "args": {
                "path": "{{OK_FILE}}"
              }
            },
            "definition_change": {
